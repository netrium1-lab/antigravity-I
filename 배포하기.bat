@echo off
chcp 65001 > nul
echo ==============================================
echo       깃허브(GitHub) 즉시 배포 진행 중...
echo ==============================================

git add .
git commit -m "홈페이지 업데이트"
git push origin main

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ==============================================
    echo [성공] 수정된 내용이 깃허브에 배포되었습니다!
    echo ==============================================
) else (
    echo.
    echo ==============================================
    echo [오류] 깃허브 연결(원격 저장소 주소) 또는 로그인을 확인해 주세요.
    echo ==============================================
)

pause
